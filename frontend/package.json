{
  "name": "pakistan-tax-consultancy-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React + TypeScript frontend (client portal + consultant workspace) for the Pakistan Income Tax Consultancy ERP",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-portal-page.mjs && npm run build:site",
    "build:site": "tailwindcss -c tailwind.site.config.js -i src/styles/globals.css -o ../pakistan_tax_consultancy/public/css/site.css --minify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-table": "^8.20.5",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "frappe-react-sdk": "^1.17.1",
    "i18next": "24.2.3",
    "lucide-react": "^0.441.0",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "15.4.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "25.0.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "2.1.9"
  }
}
