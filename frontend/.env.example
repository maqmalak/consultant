# Frappe site the SPA talks to in dev (Vite proxies /api → this URL)
VITE_PROXY_TARGET=http://localhost:8010
# Site name used in Host / X-Frappe-Site-Name headers (multi-tenant routing)
VITE_FRAPPE_SITE=consultant
# Leave empty when the SPA is served same-origin by the site itself (prod).
VITE_FRAPPE_URL=
# Socket.IO realtime (disable if not needed)
VITE_ENABLE_SOCKET=true
